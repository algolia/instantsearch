{
  "extends": ["../.oxlintrc.json"],
  "rules": {
    "import/no-commonjs": "off",
    "instantsearch/naming-convention": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "instantsearch.js",
              "instantsearch.js/**",
              "instantsearch-core",
              "instantsearch-core/**"
            ],
            "message": "Import from `vue-instantsearch` (or `vue-instantsearch/vue3`) instead."
          }
        ]
      }
    ],
    "react-hooks/exhaustive-deps": "off",
    "react-hooks/rules-of-hooks": "off",
    "vue/multi-word-component-names": "off"
  }
}
